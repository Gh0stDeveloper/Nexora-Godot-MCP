NEXORA_GODOT_AUTH_MODE=static
NEXORA_GODOT_GATEWAY_HOST=127.0.0.1
NEXORA_GODOT_GATEWAY_PORT=8775
NEXORA_GODOT_PUBLIC_TOKEN=replace-with-at-least-32-random-characters

NEXORA_GODOT_OAUTH_ISSUER_URL=
NEXORA_GODOT_OAUTH_RESOURCE_URL=
NEXORA_GODOT_OAUTH_INTROSPECTION_URL=
NEXORA_GODOT_OAUTH_CLIENT_ID=
NEXORA_GODOT_OAUTH_CLIENT_SECRET=
NEXORA_GODOT_OAUTH_INTROSPECTION_AUTH_METHOD=basic
NEXORA_GODOT_OAUTH_REQUIRED_SCOPES=godot:read,godot:write
NEXORA_GODOT_OAUTH_EXPECTED_AUDIENCE=
NEXORA_GODOT_OAUTH_VALIDATE_AUDIENCE=true
NEXORA_GODOT_OAUTH_TIMEOUT_SECONDS=10

NEXORA_GODOT_ALLOWED_HOSTS=127.0.0.1:*,localhost:*,[::1]:*
NEXORA_GODOT_ALLOWED_ORIGINS=http://127.0.0.1:*,http://localhost:*,http://[::1]:*

NEXORA_GODOT_BRIDGE_HOST=127.0.0.1
NEXORA_GODOT_BRIDGE_PORT=9877
NEXORA_GODOT_BRIDGE_SECRET=replace-with-a-different-32-character-secret
NEXORA_GODOT_REQUEST_TIMEOUT_SECONDS=120

NEXORA_GODOT_PERMISSION_PROFILE=standard
NEXORA_GODOT_ALLOW_EDITOR_SCRIPT=false
NEXORA_GODOT_PROJECT_ROOT=~/NexoraGodotWorkspace/MyGame
NEXORA_GODOT_GODOT_BINARY=godot
NEXORA_GODOT_AUDIT_LOG=./var/audit.jsonl
NEXORA_GODOT_RUNTIME_LOG_DIR=./var/runs
NEXORA_GODOT_LOG_LEVEL=INFO
